.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
outputs/
.DS_Store

# Model weights are pulled locally; only the manifest and the small upstream config/text files are committable
weights/**/*.safetensors
weights/**/*.pt
weights/**/*.pth
weights/**/*.ckpt
weights/**/*.bin
weights/**/.cache/

# the pinned dataset tarball, its extracted chips and the index are fetched at run time
weights/hls-burn-scars/

# the upstream example chips are manifest-listed and staged from the Hub at run time
weights/**/examples/
weights/**/*.tif
